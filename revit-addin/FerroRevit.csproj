<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ferro for Revit 2025+ (.NET 8). Thin shell: all mapping logic is in the
       Rust core (ferro-revit), reached over Ferro Link or ferro_ffi.dll. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FerroRevit</AssemblyName>
    <RootNamespace>Ferro.Revit</RootNamespace>
    <Version>0.3.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference assemblies only; Revit supplies the real ones at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Ferro.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
