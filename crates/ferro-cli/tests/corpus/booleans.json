[
  {"id": "pocket_box", "tool": "create_box", "args": {"origin": [0, 0, 0], "width": "2m", "depth": "2m", "height": "1m", "name": "Pocket"}},
  {"id": "pocket_cut", "tool": "create_box", "args": {"origin": [500, 500, 600], "width": 800, "depth": 600, "height": 600}},
  {"id": "pocket", "tool": "subtract_forms", "args": {"target": {"$ref": "pocket_box.result.element"}, "cutter": {"$ref": "pocket_cut.result.element"}}},
  {"id": "hole_box", "tool": "create_box", "args": {"origin": ["4m", 0, 0], "width": "2m", "depth": "2m", "height": "1m", "name": "Through hole"}},
  {"id": "hole_cut", "tool": "create_box", "args": {"origin": [4700, 700, -200], "width": 500, "depth": 400, "height": 1400}},
  {"id": "hole", "tool": "subtract_forms", "args": {"target": {"$ref": "hole_box.result.element"}, "cutter": {"$ref": "hole_cut.result.element"}}},
  {"id": "wall", "tool": "create_box", "args": {"origin": ["8m", 0, 0], "width": "4m", "depth": 200, "height": "3m", "name": "Wall with flush opening"}},
  {"id": "opening", "tool": "create_box", "args": {"origin": [9000, 0, 900], "width": 1200, "depth": 200, "height": 1200, "name": "Kept cutter"}},
  {"id": "flush", "tool": "subtract_forms", "args": {"target": {"$ref": "wall.result.element"}, "cutter": {"$ref": "opening.result.element"}, "keep_cutter": true}}
]
